# Copy to .env and fill in, then:  set -a; source .env; set +a
# The pipeline runs WITHOUT any of these (offline fallbacks); set a key to enable
# real recognition + generation via a hosted model.

# Pick one provider (or leave blank to auto-detect from whichever key is set;
# OpenAI is preferred when multiple keys are present):
SNAP_LLM_PROVIDER=openai
# SNAP_LLM_PROVIDER=anthropic
# SNAP_LLM_PROVIDER=gemini

# --- OpenAI (default) ---
# OPENAI_API_KEY=your_key_here
# SNAP_OPENAI_MODEL=gpt-4o-mini        # cheap, vision-capable, universally available
# SNAP_OPENAI_MODEL=gpt-5.4-mini       # newer, stronger image reasoning (if enabled on your account)
# gpt-*-nano works but is weaker at fine-grained recognition/OCR — not recommended here.

# --- Anthropic (Claude) ---
# ANTHROPIC_API_KEY=your_key_here
# SNAP_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Google AI Studio (Gemini) — has a free tier ---
# GEMINI_API_KEY=your_key_here
# SNAP_GEMINI_MODEL=gemini-2.5-flash

# --- Retrieval backend (price + image source) ---
# off      = Open Food Facts / Open Products Facts (free, no key; coverage varies, images often weak).
# shopping = Serper.dev Google Shopping (real retailer price + clean image). Free key: https://serper.dev
# SNAP_RETRIEVE_BACKEND=off
# SERPER_API_KEY=your_key_here
# SNAP_SHOPPING_GL=ca            # region for Google Shopping prices (local-first)
# SNAP_PREFERRED_CURRENCIES=CAD,USD   # prefer these; foreign-currency listings are deprioritised
# Barcode-detail source after OFF/OPF (barcode-first). Default "websearch" reuses SERPER_API_KEY —
# a web search on barcodelookup.com + LLM name extraction (no extra account, ~1 credit + tiny LLM call).
# SNAP_BARCODE_SOURCE=websearch      # websearch | ecomsource | none
# EcomSource is only needed if SNAP_BARCODE_SOURCE=ecomsource (free account, 10 lookups/day):
# SNAP_ECOMSOURCE_ACCESS_KEY=your_access_key   # from https://www.ecomsource.ai
# SNAP_ECOMSOURCE_SECRET_KEY=your_secret_key
# Retailer preference (comma-separated, case-insensitive substrings of the shopping source name):
# reputable retailers get a ranking bonus; resale/marketplace sites get a penalty. Defaults cover
# the common ones; override to taste.
# SNAP_PREFERRED_SOURCES=amazon,walmart,best buy,costco,target,staples,canadian tire
# SNAP_DEMOTED_SOURCES=ebay,kijiji,poshmark,etsy,aliexpress,temu,facebook

# --- Prove real inference: disable the offline sidecar fallback ---
# With this set, recognition uses ONLY the hosted model (no <image>.json fallback),
# so a correct result proves the model actually ran.
# SNAP_STRICT_PROVIDER=1

# --- Demo: always swap in the retrieved catalogue image (skip the same-SKU match gate) ---
# The verified pipeline only adopts a catalogue image when the same-SKU match score clears
# SNAP_IMAGE_MATCH_THRESHOLD. For demos, set this to adopt the retrieved image whenever one exists.
# SNAP_ALWAYS_SWAP=1

# --- Image strategy ---
# enhance = clean your OWN photo (background removal, needs `rembg`) and adopt an external image
#           only if it's a confirmed same-SKU match AND not lower quality; swap = adopt any
#           confirmed same-SKU catalogue image; off = keep the original photo. Default: enhance.
# SNAP_IMAGE_MODE=enhance

# --- Same-SKU image verification (LLM judge) ---
# The vision model compares your photo with each candidate catalogue image and decides whether it
# is the SAME product (brand + variant + size) before any swap. On by default; falls back to the
# numeric CLIP/phash gate when no provider is configured. Set to 0 to force the numeric gate.
# SNAP_IMAGE_MATCH_LLM=1
# SNAP_LLM_MATCH_MIN_CONF=0.7    # adopt only when the model's confidence is >= this
# SNAP_LLM_MATCH_TOPK=2          # how many top-ranked candidates to verify per item (cost control)

# --- Price confidence gate ---
# Decline to price a shopping match (route to human review, emit no price) when it is ambiguous
# or its brand can't be confirmed against the recognised brand — rather than publishing a
# wrong-product price. On by default; set to 0 to always emit the best-guess price.
# SNAP_PRICE_CONFIDENCE_GATE=1

# --- Thresholds (optional overrides) ---
# SNAP_CONFIDENCE_THRESHOLD=0.5
# SNAP_IMAGE_MATCH_THRESHOLD=0.80   # numeric fallback gate only
# SNAP_CURRENCY=CAD
# SNAP_HTTP_TIMEOUT=10
